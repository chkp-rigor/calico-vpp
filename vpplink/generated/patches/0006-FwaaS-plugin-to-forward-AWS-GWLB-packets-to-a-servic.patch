diff --git a/src/plugins/fwaas_geneve_router/fwaas_cmd_handler.c b/src/plugins/fwaas_geneve_router/fwaas_cmd_handler.c
new file mode 100644
index 000000000..7006f5d5e
--- /dev/null
+++ b/src/plugins/fwaas_geneve_router/fwaas_cmd_handler.c
@@ -0,0 +1,117 @@
+#include <vlib/vlib.h>
+
+#include <fwaas_geneve_router/fwaas_cmd_handler.h>
+
+#include <fwaas_geneve_router/options_parser.h>
+#include <fwaas_geneve_router/fwaas_geneve_router.h>
+
+u8
+handle_rewrite_cmd (vlib_buffer_t *b, u32 is_ip4)
+{
+  fwaas_geneve_router_main_t *vxm = &fwaas_geneve_router_main;
+  vlib_main_t *vm = vlib_get_main();
+  ip4_header_t *ip4 = NULL;
+  ip6_header_t *ip6 = NULL;
+  udp_header_t *udp_header = NULL;
+  geneve_header_t *geneve = NULL;
+  aws_glb_tlvs tlvs = {0};
+  word advance_offset = 0;
+  u8 rewritten = 0;
+
+  if (is_ip4)
+    {
+      ip4 = vlib_buffer_get_current (b);
+      vlib_buffer_advance (b, sizeof (*ip4));
+      advance_offset += sizeof (*ip4);
+    }
+  else
+    {
+      ip6 = vlib_buffer_get_current (b);
+      vlib_buffer_advance (b, sizeof (*ip6));
+      advance_offset += sizeof (*ip6);
+    }
+
+  udp_header = vlib_buffer_get_current (b);
+  vlib_buffer_advance (b, sizeof (*udp_header));
+
+  geneve = vlib_buffer_get_current (b);
+  vnet_geneve_hdr_1word_ntoh (geneve);
+  vlib_buffer_advance (b, GENEVE_BASE_HEADER_LENGTH);
+  advance_offset += sizeof (*udp_header) + GENEVE_BASE_HEADER_LENGTH;
+
+  if (vnet_get_geneve_version (geneve) != GENEVE_VERSION)
+    {
+      vlib_log_debug (vxm->log_class, "[FwaaS] Not a geneve packet");
+      goto done;
+    }
+
+  tlvs = read_geneve_options (b, geneve, &advance_offset);
+  if (tlvs.vpce_id == 0)
+    {
+      goto done;
+    }
+
+  uword *result = hash_get (vxm->vpce_id_dst_ip_map, tlvs.vpce_id);
+  if (result == NULL)
+    {
+      vlib_log_debug (vxm->log_class,
+        "[FwaaS] vpce id not added to map vpce id: 0x%lx, attachment id: 0x%lx, flow cookie: 0x%x",
+        tlvs.vpce_id, tlvs.attachment_id, tlvs.flow_cookie);
+      goto done;
+    }
+
+  vlib_log_debug (vxm->log_class,
+      "[FwaaS] Forwarding packet with details vpce id: 0x%lx, attachment id: 0x%lx, flow cookie: 0x%x",
+      tlvs.vpce_id, tlvs.attachment_id, tlvs.flow_cookie);
+  ip46_address_t dst_addr;
+  clib_memcpy (&dst_addr, (ip46_address_t*)*result, sizeof (ip46_address_t));
+
+  /*
+   * Reset the buffer pointer to the start of the packet
+   * as we are sending it back to by changing dst ip
+  */
+  vlib_buffer_advance (b, -(word) (advance_offset));
+
+  udp_header->src_port = (u16) tlvs.flow_cookie;
+  vlib_log_debug (vxm->log_class,
+      "[FwaaS] flow cookie set to src port: 0x%x", udp_header->src_port);
+
+  if (is_ip4)
+    {
+      ip4->dst_address.as_u32 = dst_addr.ip4.as_u32;
+      ip4->checksum = ip4_header_checksum (ip4);
+
+      udp_header->checksum = 0;
+      if (!(b->flags & VNET_BUFFER_OFFLOAD_F_UDP_CKSUM))
+        {
+          udp_header->checksum = ip4_tcp_udp_compute_checksum (vm, b, ip4);
+          if (udp_header->checksum == 0)
+            udp_header->checksum = 0xffff;
+        }
+      else
+        {
+          vnet_buffer_offload_flags_set (b, VNET_BUFFER_OFFLOAD_F_UDP_CKSUM);
+        }
+
+        vlib_log_debug (vxm->log_class,
+            "[FwaaS] udp checksum updated: 0x%x", udp_header->checksum);
+    }
+  else
+    {
+      ip6->dst_address.as_u128 = dst_addr.ip6.as_u128;
+    }
+
+  /* Set advance offset to zero as we have already did a rewind for calculating checksum */
+  advance_offset = 0;
+  rewritten = 1;
+
+done:
+  vlib_buffer_advance (b, -(word) (advance_offset));
+  /*
+  * Reset the first word to original value as we are rerouting
+  * the same packet to different IP address.
+  */
+  vnet_geneve_hdr_1word_hton (geneve);
+
+  return rewritten;
+}
