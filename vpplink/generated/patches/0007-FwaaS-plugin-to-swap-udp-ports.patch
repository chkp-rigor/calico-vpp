diff --git a/src/plugins/fwaas_udp_swap/node.c b/src/plugins/fwaas_udp_swap/node.c
new file mode 100644
index 000000000..d6bc65cda
--- /dev/null
+++ b/src/plugins/fwaas_udp_swap/node.c
@@ -0,0 +1,285 @@
+/*
+ * node.c - skeleton vpp engine plug-in dual-loop node skeleton
+ *
+ * Copyright (c) <current-year> <your-organization>
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at:
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#include <vlib/vlib.h>
+#include <vnet/vnet.h>
+#include <vnet/pg/pg.h>
+#include <vnet/udp/udp_local.h>
+#include <vppinfra/error.h>
+#include <fwaas_udp_swap/fwaas_udp_swap.h>
+
+#include <arpa/inet.h>
+
+typedef struct
+{
+  u8 udp_port_swapped;
+} fwaas_udp_swap_trace_t;
+
+#ifndef CLIB_MARCH_VARIANT
+
+/* packet trace format function */
+static u8 * format_fwaas_udp_swap_trace (u8 * s, va_list * args)
+{
+  CLIB_UNUSED (vlib_main_t * vm) = va_arg (*args, vlib_main_t *);
+  CLIB_UNUSED (vlib_node_t * node) = va_arg (*args, vlib_node_t *);
+  fwaas_udp_swap_trace_t * t = va_arg (*args, fwaas_udp_swap_trace_t *);
+  if (t->udp_port_swapped == 1)
+    {
+      s = format (s, "FWAAS_UDP_SWAP: UDP ports swapped = true\n");
+    }
+  else
+    {
+      s = format (s, "FWAAS_UDP_SWAP: UDP ports swapped = false\n");
+    }
+
+  return s;
+}
+
+#endif /* CLIB_MARCH_VARIANT */
+
+#define foreach_fwaas_udp_swap_error \
+_(SWAPPED, "AWS GWLB upd port swapped")
+
+typedef enum {
+#define _(sym,str) FWAAS_UDP_SWAP_ERROR_##sym,
+  foreach_fwaas_udp_swap_error
+#undef _
+  FWAAS_UDP_SWAP_N_ERROR,
+} fwaas_udp_swap_error_t;
+
+#ifndef CLIB_MARCH_VARIANT
+static char * fwaas_udp_swap_error_strings[] =
+{
+#define _(sym,string) string,
+  foreach_fwaas_udp_swap_error
+#undef _
+};
+#endif /* CLIB_MARCH_VARIANT */
+
+typedef enum
+{
+  FWAAS_UDP_SWAP_NEXT_INTERFACE_OUTPUT,
+  FWAAS_UDP_SWAP_N_NEXT,
+} fwaas_udp_swap_next_t;
+
+static_always_inline u8
+swap_udp_ports (vlib_buffer_t *b)
+{
+  fwaas_udp_swap_main_t *vxm = &fwaas_udp_swap_main;
+  i16 l3_hdr_offset = vnet_buffer (b)->l3_hdr_offset;
+  u8 result = 0;
+
+  if (PREDICT_FALSE (b->flags & VNET_BUFFER_F_IS_IP6))
+    {
+      vlib_log_debug (vxm->log_class, "[FwaaS-out] ignoring IPv6");
+      goto done; /* ignore ip6 */
+    }
+
+  if (PREDICT_FALSE (l3_hdr_offset == 0))
+    {
+      vlib_log_debug (vxm->log_class, "[FwaaS-out] invalid l3 header offset");
+      goto done;
+    }
+
+  ip4_header_t *ip4 = (void *) (b->data + l3_hdr_offset);
+
+  if (PREDICT_FALSE (ip4->protocol != IP_PROTOCOL_UDP))
+    {
+      vlib_log_debug (vxm->log_class, "[FwaaS-out] ignoring non udp protocol: %u", ip4->protocol);
+      goto done; /* not udp protocol */
+    }
+
+  ip46_address_t ip46;
+  ip46_address_set_ip4 (&ip46, &ip4->dst_address);
+  uword *entry = hash_get_mem (vxm->gwlb_ip_map, &ip46);
+
+  char dst_addr[INET_ADDRSTRLEN];
+  char src_addr[INET_ADDRSTRLEN];
+  inet_ntop(AF_INET, &(ip4->dst_address.as_u32), dst_addr, INET_ADDRSTRLEN);
+  inet_ntop(AF_INET, &(ip4->src_address.as_u32), src_addr, INET_ADDRSTRLEN);
+  if (entry == NULL)
+    {
+      /* Do not change the dst port if the dst ip does not match gwlb ip*/
+      vlib_log_debug (vxm->log_class, "[FwaaS-out] ignoring non-gwlb ip address src: %s, dst: %s", src_addr, dst_addr);
+      goto done;
+    }
+
+  vlib_log_debug (vxm->log_class, "[FwaaS-out] setting dst port to 6081 for src: %s, dst: %s", src_addr, dst_addr);
+  i16 l4_hdr_offset = vnet_buffer (b)->l3_hdr_offset + sizeof (ip4_header_t);
+  udp_header_t *udp = (void *) (b->data + l4_hdr_offset);
+
+  udp->dst_port = clib_host_to_net_u16 (UDP_DST_PORT_geneve);
+  vlib_log_debug (vxm->log_class,
+      "[FwaaS-out] udp port swapped, new src: %u, new dst: %u",
+      clib_net_to_host_u16 (udp->src_port),
+      clib_net_to_host_u16 (udp->dst_port));
+
+  udp->checksum = 0;
+  vnet_buffer_offload_flags_set (b, VNET_BUFFER_OFFLOAD_F_UDP_CKSUM);
+
+  vlib_log_debug (vxm->log_class,
+        "[FwaaS-out] udp checksum updated: 0x%x", udp->checksum);
+
+  result = 1;
+
+  done:
+    return result;
+}
+
+VLIB_NODE_FN (fwaas_udp_swap_node) (vlib_main_t * vm,
+                                    vlib_node_runtime_t * node,
+                                    vlib_frame_t * frame)
+{
+  u32 n_left_from, * from, * to_next;
+  fwaas_udp_swap_next_t next_index;
+
+  from = vlib_frame_vector_args (frame);
+  n_left_from = frame->n_vectors;
+  next_index = node->cached_next_index;
+
+  while (n_left_from > 0)
+    {
+      u32 n_left_to_next;
+      u32 next0 = FWAAS_UDP_SWAP_NEXT_INTERFACE_OUTPUT;
+      u32 next1 = FWAAS_UDP_SWAP_NEXT_INTERFACE_OUTPUT;
+
+      vlib_get_next_frame (vm, node, next_index,
+                            to_next, n_left_to_next);
+
+      while (n_left_from >= 4 && n_left_to_next >= 2)
+        {
+          u32 bi0, bi1;
+          vlib_buffer_t * b0, * b1;
+
+          /* Prefetch next iteration. */
+          {
+            vlib_buffer_t * p2, * p3;
+
+            p2 = vlib_get_buffer (vm, from[2]);
+            p3 = vlib_get_buffer (vm, from[3]);
+
+            vlib_prefetch_buffer_header (p2, LOAD);
+            vlib_prefetch_buffer_header (p3, LOAD);
+
+            CLIB_PREFETCH (p2->data, CLIB_CACHE_LINE_BYTES, STORE);
+            CLIB_PREFETCH (p3->data, CLIB_CACHE_LINE_BYTES, STORE);
+          }
+
+          /* speculatively enqueue b0 and b1 to the current next frame */
+          to_next[0] = bi0 = from[0];
+          to_next[1] = bi1 = from[1];
+          from += 2;
+          to_next += 2;
+          n_left_from -= 2;
+          n_left_to_next -= 2;
+
+          b0 = vlib_get_buffer (vm, bi0);
+          u8 swapped0 = swap_udp_ports (b0);
+
+          b1 = vlib_get_buffer (vm, bi1);
+          u8 swapped1 = swap_udp_ports (b1);
+
+          vnet_feature_next (&next0, b0);
+          vnet_feature_next (&next1, b1);
+
+          if (PREDICT_FALSE((node->flags & VLIB_NODE_FLAG_TRACE)))
+            {
+              if (b0->flags & VLIB_BUFFER_IS_TRACED)
+                {
+                    fwaas_udp_swap_trace_t *t =
+                      vlib_add_trace (vm, node, b0, sizeof (fwaas_udp_swap_trace_t));
+                    t->udp_port_swapped = swapped0;
+                  }
+                if (b1->flags & VLIB_BUFFER_IS_TRACED)
+                  {
+                    fwaas_udp_swap_trace_t *t =
+                      vlib_add_trace (vm, node, b1, sizeof (fwaas_udp_swap_trace_t));
+                    t->udp_port_swapped = swapped1;
+                  }
+              }
+            /* verify speculative enqueues, maybe switch current next frame */
+            vlib_validate_buffer_enqueue_x2 (vm, node, next_index,
+                                             to_next, n_left_to_next,
+                                             bi0, bi1, next0, next1);
+        }
+
+      while (n_left_from > 0 && n_left_to_next > 0)
+        {
+          u32 bi0;
+          vlib_buffer_t * b0;
+          u32 next0 = FWAAS_UDP_SWAP_NEXT_INTERFACE_OUTPUT;
+
+          /* speculatively enqueue b0 to the current next frame */
+          bi0 = from[0];
+          to_next[0] = bi0;
+          from += 1;
+          to_next += 1;
+          n_left_from -= 1;
+          n_left_to_next -= 1;
+
+          b0 = vlib_get_buffer (vm, bi0);
+          u8 swapped = swap_udp_ports (b0);
+          vnet_feature_next (&next0, b0);
+
+          if (PREDICT_FALSE((node->flags & VLIB_NODE_FLAG_TRACE)
+                            && (b0->flags & VLIB_BUFFER_IS_TRACED)))
+            {
+              fwaas_udp_swap_trace_t *t =
+                vlib_add_trace (vm, node, b0, sizeof (fwaas_udp_swap_trace_t));
+              t->udp_port_swapped = swapped;
+            }
+
+          /* verify speculative enqueue, maybe switch current next frame */
+          vlib_validate_buffer_enqueue_x1 (vm, node, next_index,
+                                            to_next, n_left_to_next,
+                                            bi0, next0);
+        }
+
+      vlib_put_next_frame (vm, node, next_index, n_left_to_next);
+    }
+
+  return frame->n_vectors;
+}
+
+/* *INDENT-OFF* */
+#ifndef CLIB_MARCH_VARIANT
+
+/* FIXME: Register separate node for IPv6 */
+VLIB_REGISTER_NODE (fwaas_udp_swap_node) =
+{
+  .name = "fwaas_udp_swap",
+  .flags = VLIB_NODE_FLAG_TRACE_SUPPORTED,
+  .vector_size = sizeof (u32),
+  .format_trace = format_fwaas_udp_swap_trace,
+  .type = VLIB_NODE_TYPE_INTERNAL,
+
+  .n_errors = ARRAY_LEN(fwaas_udp_swap_error_strings),
+  .error_strings = fwaas_udp_swap_error_strings,
+
+  .n_next_nodes = FWAAS_UDP_SWAP_N_NEXT,
+  .next_nodes = {
+        [FWAAS_UDP_SWAP_NEXT_INTERFACE_OUTPUT] = "interface-output",
+  },
+};
+#endif /* CLIB_MARCH_VARIANT */
+/* *INDENT-ON* */
+/*
+ * fd.io coding-style-patch-verification: ON
+ *
+ * Local Variables:
+ * eval: (c-set-style "gnu")
+ * End:
+ */
