diff --git a/src/plugins/fwaas_udp_swap/fwaas_udp_swap_cmd.c b/src/plugins/fwaas_udp_swap/fwaas_udp_swap_cmd.c
new file mode 100644
index 000000000..31c89d3ba
--- /dev/null
+++ b/src/plugins/fwaas_udp_swap/fwaas_udp_swap_cmd.c
@@ -0,0 +1,67 @@
+#include <vlib/vlib.h>
+
+#include <vnet/fib/fib_types.h>
+#include <arpa/inet.h>
+
+#include <fwaas_udp_swap/fwaas_udp_swap.h>
+
+static clib_error_t *
+vnet_fwaas_udp_swap_cmd (vlib_main_t *vm, unformat_input_t *main_input, vlib_cli_command_t *cmd)
+{
+  fwaas_udp_swap_main_t *vxm = &fwaas_udp_swap_main;
+  unformat_input_t _line_input, *line_input = &_line_input;
+  clib_error_t *error = NULL;
+  ip46_address_t gwlb_addr;
+  u8 is_del = 0;
+
+  if (!unformat_user (main_input, unformat_line_input, line_input))
+    return 0;
+
+  ip46_address_reset (&gwlb_addr);
+  while (unformat_check_input (line_input) != UNFORMAT_END_OF_INPUT)
+    {
+      if (unformat (line_input, "del"))
+        is_del = 1;
+      else if (unformat (line_input, "add"))
+        is_del = 0;
+      else if (unformat (line_input, "gwlb-ip %U",
+          unformat_ip4_address, &gwlb_addr.ip4))
+      ;
+      else if (unformat (line_input, "gwlb-ip %U",
+          unformat_ip6_address, &gwlb_addr.ip6))
+      ;
+      else
+        {
+          error = unformat_parse_error (line_input);
+          goto done;
+        }
+    }
+  if (ip46_address_is_zero(&gwlb_addr))
+    {
+      error = clib_error_return (0, "GWLB IP address is missing");
+      goto done;
+    }
+
+  uword *entry = hash_get_mem (vxm->gwlb_ip_map, &gwlb_addr);
+  if (entry != NULL)
+    {
+      hash_unset_mem_free(&vxm->gwlb_ip_map, &gwlb_addr);
+    }
+
+  if (is_del != 1)
+    {
+      hash_set_mem_alloc(&vxm->gwlb_ip_map, &gwlb_addr, 0);
+    }
+
+done:
+  unformat_free (line_input);
+  return error;
+}
+/*?
+ * This command is used to store IP address for GWLB
+?*/
+VLIB_CLI_COMMAND (fwaas_udp_swap, static) = {
+  .path = "fwaas swap",
+  .short_help = "fwaas swap [add|del] gwlb-ip <destination ip>",
+  .function = vnet_fwaas_udp_swap_cmd,
+};
