+static clib_error_t * fwaas_udp_swap_init (vlib_main_t * vm)
+{
+  fwaas_udp_swap_main_t * vxm = &fwaas_udp_swap_main;
+  clib_error_t * error = 0;
+
+  vxm->vlib_main = vm;
+  vxm->vnet_main = vnet_get_main();
+  vxm->log_class = vlib_log_register_class ("fwaas-swap", 0);
+  vxm->gwlb_ip_map = hash_create_mem (0, sizeof (uword), sizeof (u8));
+
+  vlib_log_notice (vxm->log_class, "[FwaaS] udp swap init....");
+  return error;
